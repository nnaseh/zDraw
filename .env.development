MODE="development"

# -----------------------------------------------------------------------------
# zDraw cloud services
#
# zDraw runs standalone and local-first by default: every remote service below
# is left EMPTY, which disables the feature and hides its UI (see
# excalidraw-app/app_features.ts). Point a var at your own server to enable:
#
#   Shareable read-only links : VITE_APP_BACKEND_V2_GET_URL + _POST_URL
#                               + VITE_APP_FIREBASE_CONFIG (image storage)
#   Live collaboration        : VITE_APP_WS_SERVER_URL (excalidraw-room
#                               compatible socket server, e.g.
#                               https://github.com/excalidraw/excalidraw-room)
#                               + VITE_APP_FIREBASE_CONFIG (room persistence)
#   AI text-to-diagram /
#   diagram-to-code           : VITE_APP_AI_BACKEND
#   Public library catalog    : VITE_APP_LIBRARY_URL (browse/install),
#                               VITE_APP_LIBRARY_BACKEND (publish)
# -----------------------------------------------------------------------------
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

VITE_APP_WS_SERVER_URL=

VITE_APP_AI_BACKEND=

# Firecrawl web capture (Capture ▸ Web page). Users normally paste their own
# key in the dialog (saved in localStorage "zdraw-firecrawl-api-key"). A value
# here becomes the default — it is embedded in the client bundle, so only use
# it for private/self-hosted builds.
VITE_APP_FIRECRAWL_API_KEY=

# JSON string, e.g. '{"apiKey":"...","projectId":"...","storageBucket":"..."}'
VITE_APP_FIREBASE_CONFIG=

# No error reporting to upstream Sentry
VITE_APP_DISABLE_SENTRY=true

# put these in your .env.local, or make sure you don't commit!
# must be lowercase `true` when turned on
#
# whether to disable live reload / HMR. Usuaully what you want to do when
# debugging Service Workers.
VITE_APP_DEV_DISABLE_LIVE_RELOAD=
VITE_APP_ENABLE_TRACKING=false

FAST_REFRESH=false

# The port the run the dev server
VITE_APP_PORT=3001

#Debug flags

# To enable bounding box for text containers
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=

# Set this flag to false if you want to open the overlay by default
VITE_APP_COLLAPSE_OVERLAY=true

# Set this flag to false to disable eslint
VITE_APP_ENABLE_ESLINT=true

# Enable PWA in dev server
VITE_APP_ENABLE_PWA=false

# set to true in .env.development.local to disable the prevent unload dialog
VITE_APP_DISABLE_PREVENT_UNLOAD=
